# --- Proveedor de LLM ---
# Gemini primero, Groq como respaldo si Gemini falla (ver app/rag/llm.py)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Vector store (numpy, local) ---
VECTORSTORE_PATH=./vectorstore

# --- Carpeta de documentos fuente ---
DOCS_PATH=../docs

# --- OpenWA (gateway de WhatsApp) ---
# URL donde corre el contenedor de OpenWA, ej: http://localhost:2785
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
# Secreto para verificar que el webhook viene realmente de OpenWA (si lo soporta)
OPENWA_WEBHOOK_SECRET=

# --- Endpoint /chat (pruebas manuales, no pasa por la whitelist de WhatsApp) ---
# Sin esto /chat queda inutilizable (401 siempre) en vez de abierto a cualquiera
# que llegue al puerto del backend.
INTERNAL_API_KEY=
